# Template only. Copy this file to .env if you want to change any of these. Every line is optional.
#
# AI keys do NOT go here. Open the IDE, click the gear (AI settings) in the chat panel,
# and pick a provider (Gemini / OpenAI / Anthropic), a model, and paste your own API key.
# The key stays in your browser; this server never sees it.

# TRACE_TIMEOUT_SECONDS=5
# Set to 1 to let user code import any module (os, requests, ...). Only for trusted, local use.
# TRACE_ALLOW_ALL_MODULES=0
# PORT=8000
